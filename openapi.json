                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Paramètre invalide (identifiant, saison, limit mal typé)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Ressource hors de l'offre football-data.org, par exemple une saison trop ancienne (statut relayé)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Compétition inconnue de football-data.org (statut relayé)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Quota d'appels à football-data.org atteint (10 par minute, pour tous les visiteurs)",
            "headers" : {
              "Retry-After" : {
                "description" : "Secondes à attendre avant de réessayer",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "502" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "football-data.org injoignable, ou réponse vide ou illisible"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Autre erreur de football-data.org : son statut est relayé, pas son corps"
          }
        },
        "summary" : "Matchs",
        "tags" : [ "Compétitions" ]
      }
    },
    "/api/competitions/{id}/scorers" : {
      "get" : {
        "description" : "Meilleurs buteurs. Les 50 premiers sont mis en cache puis découpés selon limit : changer de limit ne consomme pas de quota. Cache : 5 min pour la saison en cours, 24 h pour une saison terminée.",
        "operationId" : "proxyScorers",
        "parameters" : [ {
          "description" : "Code (FL1, PL…) ou identifiant numérique de la compétition",
          "example" : "FL1",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "pattern" : "^[a-zA-Z0-9_-]+$",
            "type" : "string"
          }
        }, {
          "description" : "Nombre de buteurs renvoyés (50 au plus ; tous si absent)",
          "example" : 10,
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "description" : "Année de début de la saison ; saison en cours si absent",
          "example" : 2025,
          "in" : "query",
          "name" : "season",
          "required" : false,
          "schema" : {
            "pattern" : "^\\d{4}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScorersResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Paramètre invalide (identifiant, saison, limit mal typé)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Ressource hors de l'offre football-data.org, par exemple une saison trop ancienne (statut relayé)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Compétition inconnue de football-data.org (statut relayé)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Quota d'appels à football-data.org atteint (10 par minute, pour tous les visiteurs)",
            "headers" : {
              "Retry-After" : {
                "description" : "Secondes à attendre avant de réessayer",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "502" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "football-data.org injoignable, ou réponse vide ou illisible"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Autre erreur de football-data.org : son statut est relayé, pas son corps"
          }
        },
        "summary" : "Buteurs",
        "tags" : [ "Compétitions" ]
      }
    },
    "/api/competitions/{id}/standings" : {
      "get" : {
        "description" : "Classements général, domicile et extérieur (par poule le cas échéant). Cache : 5 min pour la saison en cours, 24 h pour une saison terminée.",
        "operationId" : "proxyStandings",
        "parameters" : [ {
          "description" : "Code (FL1, PL…) ou identifiant numérique de la compétition",
          "example" : "FL1",
          "in" : "path",
          "name" : "id",
          "required" : true,
