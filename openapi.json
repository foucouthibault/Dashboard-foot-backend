{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Proxy vers football-data.org v4 : compétitions, classements, matchs et buteurs. Les réponses reprennent la structure de football-data.org, réduite aux champs lus par le frontend. Les erreurs sont des ProblemDetail (RFC 9457).",
    "license" : {
      "name" : "MIT",
      "url" : "https://opensource.org/licenses/MIT"
    },
    "title" : "Dashboard Foot API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Données de football-data.org, mises en cache",
    "name" : "Compétitions"
  } ],
  "paths" : {
    "/api/competitions/{id}" : {
      "get" : {
        "description" : "Nom, code et logo de la compétition. Cache : 60 s.",
        "operationId" : "proxyCompetition",
        "parameters" : [ {
          "description" : "Code (FL1, PL…) ou identifiant numérique de la compétition",
          "example" : "FL1",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "pattern" : "^[a-zA-Z0-9_-]+$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CompetitionResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Paramètre invalide (identifiant, saison, limit mal typé)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Ressource hors de l'offre football-data.org, par exemple une saison trop ancienne (statut relayé)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Compétition inconnue de football-data.org (statut relayé)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Quota d'appels à football-data.org atteint (10 par minute, pour tous les visiteurs)",
            "headers" : {
              "Retry-After" : {
                "description" : "Secondes à attendre avant de réessayer",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "502" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "football-data.org injoignable, ou réponse vide ou illisible"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Autre erreur de football-data.org : son statut est relayé, pas son corps"
          }
        },
        "summary" : "Compétition",
        "tags" : [ "Compétitions" ]
      }
    },
    "/api/competitions/{id}/matches" : {
      "get" : {
        "description" : "Matchs de la saison en cours. Cache : 60 s.",
        "operationId" : "proxyMatches",
        "parameters" : [ {
