      }
    }
  },
  "components" : {
    "schemas" : {
      "CompetitionResponse" : {
        "required" : [ "code", "emblem", "id", "name" ],
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "emblem" : {
            "type" : "string",
            "nullable" : true
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          }
        }
      },
      "FullTime" : {
        "required" : [ "away", "home" ],
        "type" : "object",
        "properties" : {
          "away" : {
            "type" : "integer",
            "format" : "int32",
            "nullable" : true
          },
          "home" : {
            "type" : "integer",
            "format" : "int32",
            "nullable" : true
          }
        }
      },
      "Match" : {
        "required" : [ "awayTeam", "homeTeam", "id", "matchday", "score", "status", "utcDate" ],
        "type" : "object",
        "properties" : {
          "awayTeam" : {
            "$ref" : "#/components/schemas/Team"
          },
          "homeTeam" : {
            "$ref" : "#/components/schemas/Team"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "matchday" : {
            "type" : "integer",
            "format" : "int32"
          },
          "score" : {
            "$ref" : "#/components/schemas/Score"
          },
          "status" : {
            "type" : "string"
          },
          "utcDate" : {
            "type" : "string"
          }
        }
      },
      "MatchesResponse" : {
        "required" : [ "matches" ],
        "type" : "object",
        "properties" : {
          "matches" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Match"
            }
          }
        }
      },
      "Player" : {
        "required" : [ "id", "name", "nationality" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "nationality" : {
            "type" : "string"
          }
        }
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "Score" : {
        "required" : [ "fullTime" ],
        "type" : "object",
        "properties" : {
          "fullTime" : {
            "$ref" : "#/components/schemas/FullTime"
          }
        }
      },
      "Scorer" : {
        "required" : [ "assists", "goals", "penalties", "player", "team" ],
        "type" : "object",
        "properties" : {
          "assists" : {
            "type" : "integer",
            "format" : "int32",
            "nullable" : true
          },
          "goals" : {
            "type" : "integer",
            "format" : "int32"
          },
          "penalties" : {
            "type" : "integer",
            "format" : "int32",
            "nullable" : true
          },
          "player" : {
            "$ref" : "#/components/schemas/Player"
          },
          "team" : {
            "$ref" : "#/components/schemas/Team"
          }
        }
      },
      "ScorersResponse" : {
        "required" : [ "count", "scorers" ],
        "type" : "object",
        "properties" : {
          "count" : {
            "type" : "integer",
            "format" : "int32",
            "nullable" : true
          },
          "scorers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Scorer"
            }
          }
        }
      },
      "StandingGroup" : {
        "required" : [ "group", "stage", "table", "type" ],
        "type" : "object",
        "properties" : {
          "group" : {
            "type" : "string",
            "nullable" : true
          },
          "stage" : {
            "type" : "string"
          },
          "table" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/StandingRow"
            }
          },
          "type" : {
            "type" : "string",
            "enum" : [ "TOTAL", "HOME", "AWAY" ]
          }
        }
      },
      "StandingRow" : {
        "required" : [ "draw", "goalDifference", "goalsAgainst", "goalsFor", "lost", "playedGames", "points", "position", "team", "won" ],
        "type" : "object",
        "properties" : {
          "draw" : {
            "type" : "integer",
            "format" : "int32"
          },
          "goalDifference" : {
            "type" : "integer",
            "format" : "int32"
          },
          "goalsAgainst" : {
            "type" : "integer",
            "format" : "int32"
          },
          "goalsFor" : {
            "type" : "integer",
            "format" : "int32"
          },
          "lost" : {
            "type" : "integer",
            "format" : "int32"
          },
          "playedGames" : {
            "type" : "integer",
            "format" : "int32"
          },
          "points" : {
            "type" : "integer",
            "format" : "int32"
          },
          "position" : {
            "type" : "integer",
            "format" : "int32"
          },
          "team" : {
            "$ref" : "#/components/schemas/Team"
          },
          "won" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "StandingsResponse" : {
        "required" : [ "standings" ],
        "type" : "object",
        "properties" : {
          "standings" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/StandingGroup"
            }
          }
        }
      },
      "Team" : {
        "required" : [ "crest", "id", "name" ],
        "type" : "object",
        "properties" : {
          "crest" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          }
        }
      }
    }
  }
}