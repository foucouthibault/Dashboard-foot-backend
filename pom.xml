<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>fr.foucouthibault</groupId>
	<artifactId>dashboard-foot-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Dashboard Foot Backend</name>
	<description>Proxy Spring Boot vers football-data.org avec cache et limite de débit</description>
	<url>https://github.com/foucouthibault/Dashboard-foot-backend</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- Analyse SonarQube Cloud, lancée depuis la CI GitHub Actions -->
		<sonar.organization>foucouthibault</sonar.organization>
		<sonar.projectKey>foucouthibault_Dashboard-foot-backend</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<!-- Jackson 3.1.7 (géré par Spring Boot 4.1.2) est touché par CVE-2026-110879
		     (GHSA-m8xf-2cr7-77ph), corrigée en 3.1.8 et 3.2.4. Le BOM aligne tous les modules.
		     À retirer quand Spring Boot gérera Jackson 3.2.4 ou plus. -->
		<jackson-bom.version>3.2.4</jackson-bom.version>
		<!-- Jackson 3 réutilise jackson-annotations de Jackson 2, géré par ce second BOM :
		     3.2.4 attend les annotations 2.22. À retirer en même temps que jackson-bom.version. -->
		<jackson-2-bom.version>2.22.4</jackson-2-bom.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @WebMvcTest et MockMvc (modularisés dans Spring Boot 4) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Couverture des tests, remontée à SonarQube Cloud via target/site/jacoco/jacoco.xml -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
